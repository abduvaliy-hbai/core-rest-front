# Browser-facing port for the V2 dashboard container. Kept off V1's port so both
# can run side by side while the redesign is being reviewed.
ATTENDANCE_DASHBOARD_V2_PORT=5176

# Server-side proxy target, including the API's own route prefix.
#
# On the server (compose.yml): `api` is the bride-rest-api-orm service on the
# shared network, and the port must match that stack's BRIDE_API_PORT.
#   BRIDE_API_INTERNAL_URL=http://api:38000/api/v1
#
# For local review (compose.local.yml): leave this unset and the public origin
# is used. There is no `api` container on a laptop, and no shared network.
